{
  "name": "eftracking",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Escape from Tarkov quest and Kappa tracker. Static site, no build step.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "snapshot": "node scripts/update-snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.0"
  }
}
